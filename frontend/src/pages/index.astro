---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Financial Analysis Dashboard" description="Professional financial analysis tools and valuation platform">
  <div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-blue-900 transition-colors duration-200">
    <!-- Navigation Header -->
    <nav class="bg-white dark:bg-gray-800 shadow-lg border-b border-gray-200 dark:border-gray-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Hobbyist's Financial Tools</h1>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <span class="text-sm text-gray-600 dark:text-gray-300">Organic-Research</span>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-gray-900 dark:text-white mb-6">
          Homepage
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-4xl mx-auto">
          A collection of handy financial tools for personal investing and learning about company valuations.
        </p>
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- DCF Valuation Tool -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
          <div class="p-8">
            <div class="flex items-center justify-center w-16 h-16 bg-blue-100 dark:bg-blue-900 rounded-lg mb-6 mx-auto">
              <svg class="w-8 h-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">DCF Valuation</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6 text-center">
            </p>
            <div class="space-y-2 mb-6">
              <div class="flex items-center text-sm text-gray-600 dark:text-gray-300">
                <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Multi-year projections
              </div>
              <div class="flex items-center text-sm text-gray-600 dark:text-gray-300">
                <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Sensitivity analysis
              </div>
              <div class="flex items-center text-sm text-gray-600 dark:text-gray-300">
                <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Visual charts & reports
              </div>
            </div>
            <a
              href="/dcf-tool"
              class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg text-center transition duration-200"
            >
              Launch DCF Tool
            </a>
          </div>
        </div>

        <!-- Coming Soon: Portfolio Analysis -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg opacity-75">
          <div class="p-8">
            <div class="flex items-center justify-center w-16 h-16 bg-purple-100 dark:bg-purple-900 rounded-lg mb-6 mx-auto">
              <svg class="w-8 h-8 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">Portfolio Analysis</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6 text-center">
              Advanced portfolio optimization, risk analysis, and performance tracking tools for investment management.
            </p>
            <div class="bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-700 rounded-lg p-4 mb-6">
              <p class="text-purple-700 dark:text-purple-300 text-sm font-medium text-center">Coming Soon</p>
            </div>
          </div>
        </div>

        <!-- Coming Soon: Monte Carlo Simulation -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg opacity-75">
          <div class="p-8">
            <div class="flex items-center justify-center w-16 h-16 bg-green-100 dark:bg-green-900 rounded-lg mb-6 mx-auto">
              <svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">Monte Carlo</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6 text-center">
              Probabilistic modeling and risk assessment using Monte Carlo simulation for complex financial scenarios.
            </p>
            <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-lg p-4 mb-6">
              <p class="text-green-700 dark:text-green-300 text-sm font-medium text-center">Coming Soon</p>
            </div>
          </div>
        </div>

        <!-- Coming Soon: Options Pricing -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg opacity-75">
          <div class="p-8">
            <div class="flex items-center justify-center w-16 h-16 bg-orange-100 dark:bg-orange-900 rounded-lg mb-6 mx-auto">
              <svg class="w-8 h-8 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">Options Pricing</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6 text-center">
              Black-Scholes and binomial options pricing models with Greeks calculation and volatility analysis.
            </p>
            <div class="bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-700 rounded-lg p-4 mb-6">
              <p class="text-orange-700 dark:text-orange-300 text-sm font-medium text-center">Coming Soon</p>
            </div>
          </div>
        </div>

        <!-- Coming Soon: Credit Risk -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg opacity-75">
          <div class="p-8">
            <div class="flex items-center justify-center w-16 h-16 bg-red-100 dark:bg-red-900 rounded-lg mb-6 mx-auto">
              <svg class="w-8 h-8 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.464 0L4.35 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">Credit Risk</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6 text-center">
              Credit scoring, probability of default modeling, and loss given default calculations for risk management.
            </p>
            <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-lg p-4 mb-6">
              <p class="text-red-700 dark:text-red-300 text-sm font-medium text-center">Coming Soon</p>
            </div>
          </div>
        </div>

        <!-- Coming Soon: Bond Pricing -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg opacity-75">
          <div class="p-8">
            <div class="flex items-center justify-center w-16 h-16 bg-indigo-100 dark:bg-indigo-900 rounded-lg mb-6 mx-auto">
              <svg class="w-8 h-8 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">Bond Pricing</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6 text-center">
              Fixed income analysis with yield calculations, duration, convexity, and bond portfolio optimization.
            </p>
            <div class="bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-200 dark:border-indigo-700 rounded-lg p-4 mb-6">
              <p class="text-indigo-700 dark:text-indigo-300 text-sm font-medium text-center">Coming Soon</p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
