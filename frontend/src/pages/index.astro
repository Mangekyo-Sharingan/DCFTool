---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DCF Valuation Tool" description="Professional DCF analysis and company valuation platform">
  <div id="app" class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <!-- Navigation Header -->
    <nav class="bg-white shadow-lg border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <h1 class="text-2xl font-bold text-gray-900">DCF Valuation Tool</h1>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <span class="text-sm text-gray-600">Professional Financial Analysis</span>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          Discounted Cash Flow Analysis
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Professional-grade DCF valuation with comprehensive sensitivity analysis and scenario modeling
        </p>
      </div>

      <!-- Input Form Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <!-- Company Information -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Company Information</h3>

            <div class="space-y-4">
              <div>
                <label for="ticker" class="block text-sm font-medium text-gray-700 mb-1">
                  Stock Ticker
                </label>
                <input
                  type="text"
                  id="ticker"
                  placeholder="e.g., AAPL"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <button
                  id="fetch-data-btn"
                  class="mt-2 w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition duration-200"
                >
                  Fetch Company Data
                </button>
              </div>

              <div>
                <label for="industry" class="block text-sm font-medium text-gray-700 mb-1">
                  Industry
                </label>
                <input
                  type="text"
                  id="industry"
                  placeholder="e.g., Technology"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Financial Inputs -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Financial Parameters</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="enterprise_value" class="block text-sm font-medium text-gray-700 mb-1">
                  Enterprise Value (M)
                </label>
                <input
                  type="number"
                  id="enterprise_value"
                  placeholder="0"
                  step="0.01"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="debt" class="block text-sm font-medium text-gray-700 mb-1">
                  Total Debt (M)
                </label>
                <input
                  type="number"
                  id="debt"
                  placeholder="0"
                  step="0.01"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="cash" class="block text-sm font-medium text-gray-700 mb-1">
                  Cash & Equivalents (M)
                </label>
                <input
                  type="number"
                  id="cash"
                  placeholder="0"
                  step="0.01"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="shares_outstanding" class="block text-sm font-medium text-gray-700 mb-1">
                  Shares Outstanding (M) *
                </label>
                <input
                  type="number"
                  id="shares_outstanding"
                  placeholder="0"
                  step="0.01"
                  required
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="last_fcf" class="block text-sm font-medium text-gray-700 mb-1">
                  Last FCF (M) *
                </label>
                <input
                  type="number"
                  id="last_fcf"
                  placeholder="0"
                  step="0.01"
                  required
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="growth_rate" class="block text-sm font-medium text-gray-700 mb-1">
                  Growth Rate (%) *
                </label>
                <input
                  type="number"
                  id="growth_rate"
                  placeholder="5"
                  step="0.1"
                  required
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="wacc" class="block text-sm font-medium text-gray-700 mb-1">
                  WACC (%) *
                </label>
                <input
                  type="number"
                  id="wacc"
                  placeholder="8"
                  step="0.1"
                  required
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="terminal_growth_rate" class="block text-sm font-medium text-gray-700 mb-1">
                  Terminal Growth Rate (%) *
                </label>
                <input
                  type="number"
                  id="terminal_growth_rate"
                  placeholder="2"
                  step="0.1"
                  required
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="projection_years" class="block text-sm font-medium text-gray-700 mb-1">
                  Projection Years
                </label>
                <select
                  id="projection_years"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                  <option value="5">5 Years</option>
                  <option value="10">10 Years</option>
                  <option value="15">15 Years</option>
                </select>
              </div>
            </div>

            <div class="mt-6">
              <button
                id="calculate-btn"
                class="w-full bg-green-600 text-white py-3 px-6 rounded-md hover:bg-green-700 transition duration-200 font-semibold text-lg"
              >
                Calculate DCF Valuation
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Results Section -->
      <div id="results-section" class="hidden">
        <!-- Valuation Results -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Valuation Results</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="text-center">
              <div class="text-3xl font-bold text-green-600" id="intrinsic-value">$0.00</div>
              <div class="text-sm text-gray-600">Intrinsic Value per Share</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-600" id="current-price">$0.00</div>
              <div class="text-sm text-gray-600">Current Market Price</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold" id="upside-percentage">0%</div>
              <div class="text-sm text-gray-600">Upside/Downside</div>
            </div>
          </div>
        </div>

        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Cash Flow Projections</h3>
            <canvas id="projections-chart" width="400" height="300"></canvas>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Sensitivity Analysis</h3>
            <canvas id="sensitivity-chart" width="400" height="300"></canvas>
          </div>
        </div>

        <!-- Scenario Analysis -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Scenario Analysis</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Scenario</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Intrinsic Value</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Upside %</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Growth Rate</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">WACC</th>
                </tr>
              </thead>
              <tbody id="scenarios-table" class="bg-white divide-y divide-gray-200">
                <!-- Scenario data will be populated here -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Loading State -->
      <div id="loading" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg p-6">
          <div class="flex items-center space-x-3">
            <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600"></div>
            <span class="text-gray-700">Calculating valuation...</span>
          </div>
        </div>
      </div>

      <!-- Error Display -->
      <div id="error-message" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        <span id="error-text"></span>
      </div>

      <!-- Success Display -->
      <div id="success-message" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        <span id="success-text"></span>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    // API Configuration - environment aware
    const API_BASE_URL = window.location.origin + '/api';

    // DOM Elements
    const tickerInput = document.getElementById('ticker');
    const fetchDataBtn = document.getElementById('fetch-data-btn');
    const calculateBtn = document.getElementById('calculate-btn');
    const resultsSection = document.getElementById('results-section');
    const loadingDiv = document.getElementById('loading');
    const errorMessage = document.getElementById('error-message');
    const successMessage = document.getElementById('success-message');

    // Show/Hide utilities
    function showLoading() {
      loadingDiv.classList.remove('hidden');
    }

    function hideLoading() {
      loadingDiv.classList.add('hidden');
    }

    function showError(message) {
      console.error('Error:', message); // Add debugging
      document.getElementById('error-text').textContent = message;
      errorMessage.classList.remove('hidden');
      setTimeout(() => {
        errorMessage.classList.add('hidden');
      }, 5000);
    }

    function showSuccess(message) {
      document.getElementById('success-text').textContent = message;
      successMessage.classList.remove('hidden');
      setTimeout(() => {
        successMessage.classList.add('hidden');
      }, 5000);
    }

    function showResults() {
      resultsSection.classList.remove('hidden');
      resultsSection.scrollIntoView({ behavior: 'smooth' });
    }

    // Test API connection on page load
    async function testAPIConnection() {
      try {
        console.log('Testing API connection...');
        const response = await fetch(`${API_BASE_URL}/health`, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
          },
          mode: 'cors'
        });

        if (response.ok) {
          const result = await response.json();
          console.log('API connection successful:', result);
        } else {
          console.error('API health check failed:', response.status, response.statusText);
        }
      } catch (error) {
        console.error('API connection failed:', error);
        showError('Cannot connect to backend API. Make sure Flask server is running on port 5000.');
      }
    }

    // Test connection when page loads
    document.addEventListener('DOMContentLoaded', testAPIConnection);

    // Fetch company data
    fetchDataBtn.addEventListener('click', async () => {
      const ticker = tickerInput.value.trim();
      if (!ticker) {
        showError('Please enter a stock ticker symbol');
        return;
      }

      console.log('Fetching data for ticker:', ticker);
      showLoading();
      try {
        const response = await fetch(`${API_BASE_URL}/fetch-data`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          mode: 'cors',
          body: JSON.stringify({ ticker })
        });

        console.log('Fetch response status:', response.status);

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const result = await response.json();
        console.log('Fetch result:', result);

        if (result.success) {
          // Populate form with fetched data
          const data = result.data;
          if (data.enterprise_value) document.getElementById('enterprise_value').value = data.enterprise_value;
          if (data.debt) document.getElementById('debt').value = data.debt;
          if (data.cash) document.getElementById('cash').value = data.cash;
          if (data.shares_outstanding) document.getElementById('shares_outstanding').value = data.shares_outstanding;
          if (data.last_fcf) document.getElementById('last_fcf').value = data.last_fcf;
          if (data.industry) document.getElementById('industry').value = data.industry;

          showSuccess('Data fetched successfully! Please review and adjust the values below.');
        } else {
          showError(result.error || 'Failed to fetch company data');
        }
      } catch (error) {
        console.error('Network error:', error);
        showError('Network error: ' + error.message + '. Make sure the Flask backend is running on port 5000.');
      } finally {
        hideLoading();
      }
    });

    // Calculate DCF
    calculateBtn.addEventListener('click', async () => {
      // Collect form data
      const formData = {
        ticker: document.getElementById('ticker').value,
        industry: document.getElementById('industry').value,
        enterprise_value: parseFloat(document.getElementById('enterprise_value').value) || 0,
        debt: parseFloat(document.getElementById('debt').value) || 0,
        cash: parseFloat(document.getElementById('cash').value) || 0,
        shares_outstanding: parseFloat(document.getElementById('shares_outstanding').value),
        last_fcf: parseFloat(document.getElementById('last_fcf').value),
        growth_rate: parseFloat(document.getElementById('growth_rate').value),
        wacc: parseFloat(document.getElementById('wacc').value),
        terminal_growth_rate: parseFloat(document.getElementById('terminal_growth_rate').value),
        projection_years: parseInt(document.getElementById('projection_years').value)
      };

      // Validate required fields
      const requiredFields = ['shares_outstanding', 'last_fcf', 'growth_rate', 'wacc', 'terminal_growth_rate'];
      for (const field of requiredFields) {
        if (!formData[field] && formData[field] !== 0) {
          showError(`Please fill in the ${field.replace('_', ' ')} field`);
          return;
        }
      }

      console.log('Calculating DCF with data:', formData);
      showLoading();
      try {
        const response = await fetch(`${API_BASE_URL}/calculate-dcf`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          mode: 'cors',
          body: JSON.stringify(formData)
        });

        console.log('DCF response status:', response.status);

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const result = await response.json();
        console.log('DCF result:', result);

        if (result.success) {
          displayResults(result.data);
          showResults();
        } else {
          showError(result.error || 'Failed to calculate DCF');
        }
      } catch (error) {
        console.error('Network error:', error);
        showError('Network error: ' + error.message + '. Make sure the Flask backend is running on port 5000.');
      } finally {
        hideLoading();
      }
    });

    function displayResults(data) {
      // Update valuation metrics
      document.getElementById('intrinsic-value').textContent = `$${data.intrinsic_value.toFixed(2)}`;

      const currentPrice = data.projections.current_price || 0;
      document.getElementById('current-price').textContent = `$${currentPrice.toFixed(2)}`;

      const upside = currentPrice ? ((data.intrinsic_value - currentPrice) / currentPrice * 100) : 0;
      const upsideElement = document.getElementById('upside-percentage');
      upsideElement.textContent = `${upside > 0 ? '+' : ''}${upside.toFixed(1)}%`;
      upsideElement.className = `text-3xl font-bold ${upside > 0 ? 'text-green-600' : 'text-red-600'}`;

      // Create charts
      createProjectionsChart(data.projections);
      createSensitivityChart(data.sensitivity);

      // Populate scenarios table
      populateScenariosTable(data.scenarios);
    }

    function createProjectionsChart(projections) {
      const ctx = document.getElementById('projections-chart').getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: projections.years.map(year => `Year ${year}`),
          datasets: [{
            label: 'Projected FCF',
            data: projections.projected_fcf,
            backgroundColor: 'rgba(59, 130, 246, 0.8)',
            borderColor: 'rgba(59, 130, 246, 1)',
            borderWidth: 1
          }, {
            label: 'Present Value',
            data: projections.present_values,
            backgroundColor: 'rgba(16, 185, 129, 0.8)',
            borderColor: 'rgba(16, 185, 129, 1)',
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          scales: {
            y: {
              beginAtZero: true,
              title: {
                display: true,
                text: 'Value (Millions)'
              }
            }
          }
        }
      });
    }

    function createSensitivityChart(sensitivity) {
      const ctx = document.getElementById('sensitivity-chart').getContext('2d');

      // Extract data for WACC sensitivity
      const waccData = sensitivity.wacc || [];

      new Chart(ctx, {
        type: 'line',
        data: {
          labels: waccData.map(item => `${(item.adjustment * 100).toFixed(1)}%`),
          datasets: [{
            label: 'WACC Sensitivity',
            data: waccData.map(item => item.percentage_change),
            borderColor: 'rgba(239, 68, 68, 1)',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          scales: {
            y: {
              title: {
                display: true,
                text: 'Value Change (%)'
              }
            },
            x: {
              title: {
                display: true,
                text: 'WACC Adjustment'
              }
            }
          }
        }
      });
    }

    function populateScenariosTable(scenarios) {
      const tbody = document.getElementById('scenarios-table');
      tbody.innerHTML = '';

      Object.entries(scenarios).forEach(([scenario, data]) => {
        const row = tbody.insertRow();
        row.innerHTML = `
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${scenario}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$${data.intrinsic_value.toFixed(2)}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${data.upside_percentage.toFixed(1)}%</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${(data.growth_rate * 100).toFixed(1)}%</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${(data.wacc * 100).toFixed(1)}%</td>
        `;
      });
    }
  </script>
</Layout>
