---
import Layout from '../layouts/Layout.astro';
import { Navigation } from '../components/Navigation';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card';
import { Button } from '../components/ui/button';
import { Badge } from '../components/ui/badge';
import { Separator } from '../components/ui/separator';
import "../styles/global.css";
---

<Layout title="Financial Analysis Dashboard" description="Professional financial analysis tools and valuation platform">
  <Navigation title="Financial Analysis Dashboard" client:load />
  
  <div class="min-h-screen bg-gradient-to-br from-background to-muted/20">
    <!-- Hero Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
          Professional <span class="text-primary">Financial Analysis</span>
        </h1>
        <p class="text-xl text-muted-foreground max-w-3xl mx-auto mb-8">
          A comprehensive suite of financial tools for investment analysis, company valuation, and risk assessment. 
          Built for hobbyists who demand professional-grade accuracy.
        </p>
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          <Badge variant="secondary">DCF Valuation</Badge>
          <Badge variant="secondary">Real-time Data</Badge>
          <Badge variant="secondary">Sensitivity Analysis</Badge>
          <Badge variant="secondary">Professional Reports</Badge>
        </div>
      </div>
    </section>

    <Separator />

    <!-- Tools Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-4">Financial Analysis Tools</h2>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            Choose from our collection of sophisticated financial modeling and analysis tools
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- DCF Valuation Tool -->
          <Card className="group hover:shadow-lg transition-all duration-300 border-2 hover:border-primary/50">
            <CardHeader>
              <div class="flex items-center justify-center w-12 h-12 bg-primary/10 rounded-lg mb-4 mx-auto group-hover:bg-primary/20 transition-colors">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
              <CardTitle className="text-center">DCF Valuation</CardTitle>
              <CardDescription className="text-center">
                Professional discounted cash flow analysis with multi-year projections and comprehensive sensitivity testing
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div class="space-y-2 mb-6">
                <div class="flex items-center text-sm text-muted-foreground">
                  <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd"></path>
                  </svg>
                  Real-time company data
                </div>
                <div class="flex items-center text-sm text-muted-foreground">
                  <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd"></path>
                  </svg>
                  Multi-year projections
                </div>
                <div class="flex items-center text-sm text-muted-foreground">
                  <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd"></path>
                  </svg>
                  Interactive visualizations
                </div>
              </div>
              <Button asChild className="w-full">
                <a href="/dcf-tool">Launch DCF Tool</a>
              </Button>
            </CardContent>
          </Card>

          <!-- Coming Soon Tools -->
          <Card className="opacity-75 hover:opacity-90 transition-opacity">
            <CardHeader>
              <div class="flex items-center justify-center w-12 h-12 bg-purple-100 dark:bg-purple-900/20 rounded-lg mb-4 mx-auto">
                <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
              </div>
              <CardTitle className="text-center">Portfolio Analysis</CardTitle>
              <CardDescription className="text-center">
                Advanced portfolio optimization and risk analysis tools for investment management
              </CardDescription>
            </CardHeader>
            <CardContent>
              <Badge variant="outline" className="w-full justify-center mb-4">Coming Soon</Badge>
              <Button variant="outline" disabled={true} className="w-full">
                In Development
              </Button>
            </CardContent>
          </Card>

          <Card className="opacity-75 hover:opacity-90 transition-opacity">
            <CardHeader>
              <div class="flex items-center justify-center w-12 h-12 bg-green-100 dark:bg-green-900/20 rounded-lg mb-4 mx-auto">
                <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <CardTitle className="text-center">Monte Carlo Simulation</CardTitle>
              <CardDescription className="text-center">
                Probabilistic modeling and risk assessment for complex financial scenarios
              </CardDescription>
            </CardHeader>
            <CardContent>
              <Badge variant="outline" className="w-full justify-center mb-4">Coming Soon</Badge>
              <Button variant="outline" disabled={true} className="w-full">
                In Development
              </Button>
            </CardContent>
          </Card>

          <Card className="opacity-75 hover:opacity-90 transition-opacity">
            <CardHeader>
              <div class="flex items-center justify-center w-12 h-12 bg-orange-100 dark:bg-orange-900/20 rounded-lg mb-4 mx-auto">
                <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
                </svg>
              </div>
              <CardTitle className="text-center">Options Pricing</CardTitle>
              <CardDescription className="text-center">
                Black-Scholes and binomial models with Greeks calculation and volatility analysis
              </CardDescription>
            </CardHeader>
            <CardContent>
              <Badge variant="outline" className="w-full justify-center mb-4">Coming Soon</Badge>
              <Button variant="outline" disabled={true} className="w-full">
                In Development
              </Button>
            </CardContent>
          </Card>

          <Card className="opacity-75 hover:opacity-90 transition-opacity">
            <CardHeader>
              <div class="flex items-center justify-center w-12 h-12 bg-red-100 dark:bg-red-900/20 rounded-lg mb-4 mx-auto">
                <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.464 0L4.35 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
              </div>
              <CardTitle className="text-center">Credit Risk Assessment</CardTitle>
              <CardDescription className="text-center">
                Credit scoring and probability of default modeling for comprehensive risk management
              </CardDescription>
            </CardHeader>
            <CardContent>
              <Badge variant="outline" className="w-full justify-center mb-4">Coming Soon</Badge>
              <Button variant="outline" disabled={true} className="w-full">
                In Development
              </Button>
            </CardContent>
          </Card>

          <Card className="opacity-75 hover:opacity-90 transition-opacity">
            <CardHeader>
              <div class="flex items-center justify-center w-12 h-12 bg-blue-100 dark:bg-blue-900/20 rounded-lg mb-4 mx-auto">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                </svg>
              </div>
              <CardTitle className="text-center">Bond Pricing</CardTitle>
              <CardDescription className="text-center">
                Fixed income analysis with yield curve modeling and duration calculations
              </CardDescription>
            </CardHeader>
            <CardContent>
              <Badge variant="outline" className="w-full justify-center mb-4">Coming Soon</Badge>
              <Button variant="outline" disabled={true} className="w-full">
                In Development
              </Button>
            </CardContent>
          </Card>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t bg-muted/30 py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto text-center">
        <p class="text-sm text-muted-foreground">
          © 2025 Hobbyist's Financial Tools. Built for educational and personal investment analysis.
        </p>
      </div>
    </footer>
  </div>
</Layout>
