---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DCF Valuation Tool" description="Professional DCF analysis and company valuation platform">
  <div id="app" class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-blue-900 transition-colors duration-200">
    <!-- Navigation Header -->
    <nav class="bg-white dark:bg-gray-800 shadow-lg border-b border-gray-200 dark:border-gray-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <a href="/" class="text-2xl font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                DCF Valuation Tool
              </a>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <a href="/" class="text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors">
              ← Back to Dashboard
            </a>
            <span class="text-sm text-gray-600 dark:text-gray-300">Hobbyist's Financial Tools</span>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Discounted Cash Flow Analysis
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Professional-grade DCF valuation with comprehensive sensitivity analysis and scenario modeling
        </p>
      </div>

      <!-- Input Form Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <!-- Company Information -->
        <div class="lg:col-span-1">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Company Information</h3>

            <div class="space-y-4">
              <div>
                <label for="ticker" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Stock Ticker
                </label>
                <input
                  type="text"
                  id="ticker"
                  placeholder="e.g., AAPL"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
                <button
                  id="fetch-data-btn"
                  class="mt-2 w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md transition duration-200"
                >
                  Fetch Company Data
                </button>
              </div>

              <div>
                <label for="industry" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Industry
                </label>
                <input
                  type="text"
                  id="industry"
                  placeholder="e.g., Technology"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Financial Inputs -->
        <div class="lg:col-span-2">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Financial Parameters</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="enterprise_value" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Enterprise Value (M)
                </label>
                <input
                  type="number"
                  id="enterprise_value"
                  placeholder="0"
                  step="0.01"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
              </div>

              <div>
                <label for="debt" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Total Debt (M)
                </label>
                <input
                  type="number"
                  id="debt"
                  placeholder="0"
                  step="0.01"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
              </div>

              <div>
                <label for="cash" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Cash & Equivalents (M)
                </label>
                <input
                  type="number"
                  id="cash"
                  placeholder="0"
                  step="0.01"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
              </div>

              <div>
                <label for="shares_outstanding" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Shares Outstanding (M) *
                </label>
                <input
                  type="number"
                  id="shares_outstanding"
                  placeholder="0"
                  step="0.01"
                  required
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
              </div>

              <div>
                <label for="last_fcf" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Last FCF (M) *
                </label>
                <input
                  type="number"
                  id="last_fcf"
                  placeholder="0"
                  step="0.01"
                  required
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
              </div>

              <div>
                <label for="growth_rate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Growth Rate (%) *
                </label>
                <input
                  type="number"
                  id="growth_rate"
                  placeholder="5"
                  step="0.1"
                  required
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
              </div>

              <div>
                <label for="wacc" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  WACC (%) *
                </label>
                <input
                  type="number"
                  id="wacc"
                  placeholder="8"
                  step="0.1"
                  required
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
              </div>

              <div>
                <label for="terminal_growth_rate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Terminal Growth Rate (%) *
                </label>
                <input
                  type="number"
                  id="terminal_growth_rate"
                  placeholder="2"
                  step="0.1"
                  required
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
                />
              </div>

              <div>
                <label for="projection_years" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Projection Years
                </label>
                <select
                  id="projection_years"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                >
                  <option value="5">5 Years</option>
                  <option value="10">10 Years</option>
                  <option value="15">15 Years</option>
                </select>
              </div>
            </div>

            <div class="mt-6">
              <button
                id="calculate-btn"
                class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-6 rounded-lg transition duration-200"
              >
                Calculate DCF Valuation
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Results Section -->
      <div id="results-section" class="hidden">
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 text-center border border-gray-200 dark:border-gray-700">
            <h4 class="text-lg font-semibold text-gray-700 dark:text-gray-300 mb-2">Intrinsic Value</h4>
            <div class="text-3xl font-bold text-green-600 dark:text-green-400" id="intrinsic-value">$0.00</div>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 text-center border border-gray-200 dark:border-gray-700">
            <h4 class="text-lg font-semibold text-gray-700 dark:text-gray-300 mb-2">Current Price</h4>
            <div class="text-3xl font-bold text-blue-600 dark:text-blue-400" id="current-price">$0.00</div>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 text-center border border-gray-200 dark:border-gray-700">
            <h4 class="text-lg font-semibold text-gray-700 dark:text-gray-300 mb-2">Upside/Downside</h4>
            <div class="text-3xl font-bold" id="upside-downside">0%</div>
          </div>
        </div>

        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 border border-gray-200 dark:border-gray-700">
            <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Cash Flow Projections</h4>
            <div class="w-full h-64 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center">
              <canvas id="cashFlowChart" class="w-full h-full"></canvas>
            </div>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 border border-gray-200 dark:border-gray-700">
            <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Sensitivity Analysis</h4>
            <div class="w-full h-64 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center">
              <canvas id="sensitivityChart" class="w-full h-full"></canvas>
            </div>
          </div>
        </div>

        <!-- Detailed Results Table -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 border border-gray-200 dark:border-gray-700">
          <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Detailed Projections</h4>
          <div class="overflow-x-auto">
            <table id="projections-table" class="min-w-full table-auto">
              <thead>
                <tr class="bg-gray-50 dark:bg-gray-700">
                  <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Year</th>
                  <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">FCF ($M)</th>
                  <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">PV Factor</th>
                  <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Present Value ($M)</th>
                </tr>
              </thead>
              <tbody id="projections-body" class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                <!-- Projections will be inserted here -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Loading Indicator -->
      <div id="loading-indicator" class="hidden text-center py-8">
        <div class="inline-flex items-center">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mr-3"></div>
          <span class="text-gray-700 dark:text-gray-300">Calculating valuation...</span>
        </div>
      </div>
    </main>
  </div>

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    // API Configuration
    const API_BASE_URL = window.location.origin + '/api';

    // DOM Elements
    const tickerInput = document.getElementById('ticker');
    const fetchDataBtn = document.getElementById('fetch-data-btn');
    const calculateBtn = document.getElementById('calculate-btn');
    const resultsSection = document.getElementById('results-section');
    const loadingIndicator = document.getElementById('loading-indicator');

    // Charts
    let cashFlowChart = null;
    let sensitivityChart = null;

    // Fetch company data from API
    fetchDataBtn.addEventListener('click', async () => {
      const ticker = tickerInput.value.trim().toUpperCase();
      if (!ticker) {
        alert('Please enter a stock ticker');
        return;
      }

      fetchDataBtn.disabled = true;
      fetchDataBtn.textContent = 'Fetching...';

      try {
        const response = await fetch(`${API_BASE_URL}/company-data/${ticker}`);
        if (!response.ok) throw new Error('Failed to fetch company data');

        const data = await response.json();

        // Populate form fields
        if (data.shares_outstanding) document.getElementById('shares_outstanding').value = data.shares_outstanding;
        if (data.debt) document.getElementById('debt').value = data.debt;
        if (data.cash) document.getElementById('cash').value = data.cash;
        if (data.enterprise_value) document.getElementById('enterprise_value').value = data.enterprise_value;
        if (data.industry) document.getElementById('industry').value = data.industry;
        if (data.last_fcf) document.getElementById('last_fcf').value = data.last_fcf;

        alert('Company data fetched successfully!');
      } catch (error) {
        console.error('Error fetching company data:', error);
        alert('Failed to fetch company data. Please enter manually.');
      } finally {
        fetchDataBtn.disabled = false;
        fetchDataBtn.textContent = 'Fetch Company Data';
      }
    });

    // Calculate DCF
    calculateBtn.addEventListener('click', async () => {
      // Validate required fields
      const requiredFields = ['shares_outstanding', 'last_fcf', 'growth_rate', 'wacc', 'terminal_growth_rate'];
      const missingFields = requiredFields.filter(field => !document.getElementById(field).value);

      if (missingFields.length > 0) {
        alert('Please fill in all required fields (marked with *)');
        return;
      }

      // Show loading
      loadingIndicator.classList.remove('hidden');
      resultsSection.classList.add('hidden');
      calculateBtn.disabled = true;

      // Collect form data
      const formData = {
        ticker: tickerInput.value.trim().toUpperCase(),
        industry: document.getElementById('industry').value,
        enterprise_value: parseFloat(document.getElementById('enterprise_value').value) || 0,
        debt: parseFloat(document.getElementById('debt').value) || 0,
        cash: parseFloat(document.getElementById('cash').value) || 0,
        shares_outstanding: parseFloat(document.getElementById('shares_outstanding').value),
        last_fcf: parseFloat(document.getElementById('last_fcf').value),
        growth_rate: parseFloat(document.getElementById('growth_rate').value),
        wacc: parseFloat(document.getElementById('wacc').value),
        terminal_growth_rate: parseFloat(document.getElementById('terminal_growth_rate').value),
        projection_years: parseInt(document.getElementById('projection_years').value)
      };

      try {
        console.log('Sending DCF calculation request with data:', formData);

        const response = await fetch(`${API_BASE_URL}/calculate-dcf`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        console.log('Response status:', response.status);
        console.log('Response status text:', response.statusText);

        // Always try to get the JSON response, even if status is not ok
        let results;
        try {
          results = await response.json();
          console.log('Response body:', results);
        } catch (jsonError) {
          console.error('Failed to parse JSON response:', jsonError);
          throw new Error(`Server returned status ${response.status} but response was not valid JSON`);
        }

        // Check for API errors in the response body
        if (!response.ok) {
          const errorMessage = results.error || `HTTP ${response.status}: ${response.statusText}`;
          throw new Error(`API Error: ${errorMessage}`);
        }

        // Check if the response has the expected structure
        if (!results || typeof results.intrinsic_value === 'undefined') {
          console.error('Invalid response structure:', results);
          throw new Error('Invalid response format from API - missing intrinsic_value');
        }

        // Check if the response indicates success
        if (results.success === false) {
          const errorMessage = results.error || 'Unknown error from API';
          throw new Error(`API returned error: ${errorMessage}`);
        }

        console.log('DCF calculation successful:', results);
        displayResults(results);
      } catch (error) {
        console.error('Error calculating DCF:', error);
        console.error('Error details:', {
          message: error.message,
          stack: error.stack
        });

        // Provide more specific error message
        const errorMessage = error.message.includes('API Error:') || error.message.includes('API returned error:')
          ? error.message
          : 'Calculation failed. Please check your inputs and try again.';

        alert(errorMessage);
      } finally {
        loadingIndicator.classList.add('hidden');
        calculateBtn.disabled = false;
      }
    });

    function displayResults(results) {
      // Update summary cards
      document.getElementById('intrinsic-value').textContent = `$${results.intrinsic_value.toFixed(2)}`;
      document.getElementById('current-price').textContent = `$${(results.current_price || 0).toFixed(2)}`;

      const upside = results.current_price ?
        ((results.intrinsic_value - results.current_price) / results.current_price * 100) : 0;
      const upsideElement = document.getElementById('upside-downside');
      upsideElement.textContent = `${upside.toFixed(1)}%`;
      upsideElement.className = `text-3xl font-bold ${upside >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}`;

      // Create charts using Chart.js
      createCashFlowChart(results.projections);
      createSensitivityChart(results.sensitivity_analysis);

      // Populate projections table
      populateProjectionsTable(results.projections);

      // Show results
      resultsSection.classList.remove('hidden');
    }

    function createCashFlowChart(projections) {
      const ctx = document.getElementById('cashFlowChart').getContext('2d');

      if (cashFlowChart) cashFlowChart.destroy();

      // Validate projections data
      if (!projections || !Array.isArray(projections) || projections.length === 0) {
        console.error('Invalid projections data:', projections);
        return;
      }

      const isDark = document.documentElement.classList.contains('dark');
      const textColor = isDark ? '#e5e7eb' : '#374151';
      const gridColor = isDark ? '#374151' : '#e5e7eb';

      cashFlowChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: projections.map(p => `Year ${p.year}`),
          datasets: [{
            label: 'Free Cash Flow ($M)',
            data: projections.map(p => p.fcf),
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            borderWidth: 2,
            fill: true,
            tension: 0.1
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                color: textColor,
                callback: function(value) {
                  return '$' + value.toFixed(0) + 'M';
                }
              },
              grid: { color: gridColor }
            },
            x: {
              ticks: { color: textColor },
              grid: { color: gridColor }
            }
          },
          plugins: {
            legend: {
              labels: { color: textColor }
            }
          }
        }
      });
    }

    function createSensitivityChart(sensitivityData) {
      const ctx = document.getElementById('sensitivityChart').getContext('2d');

      if (sensitivityChart) sensitivityChart.destroy();

      // Validate sensitivity data
      if (!sensitivityData || !Array.isArray(sensitivityData)) {
        console.error('Invalid sensitivity data:', sensitivityData);
        sensitivityData = [0, 0, 0];
      }

      const isDark = document.documentElement.classList.contains('dark');
      const textColor = isDark ? '#e5e7eb' : '#374151';
      const gridColor = isDark ? '#374151' : '#e5e7eb';

      sensitivityChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['WACC -1%', 'WACC Base', 'WACC +1%'],
          datasets: [{
            label: 'Intrinsic Value ($)',
            data: sensitivityData,
            backgroundColor: ['#10b981', '#3b82f6', '#ef4444'],
            borderColor: ['#059669', '#2563eb', '#dc2626'],
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                color: textColor,
                callback: function(value) {
                  return '$' + value.toFixed(0);
                }
              },
              grid: { color: gridColor }
            },
            x: {
              ticks: { color: textColor },
              grid: { color: gridColor }
            }
          },
          plugins: {
            legend: {
              labels: { color: textColor }
            }
          }
        }
      });
    }

    function populateProjectionsTable(projections) {
      const tbody = document.getElementById('projections-body');
      tbody.innerHTML = '';

      projections.forEach(projection => {
        const row = document.createElement('tr');
        row.className = 'hover:bg-gray-50 dark:hover:bg-gray-700';
        row.innerHTML = `
          <td class="px-4 py-2 text-sm text-gray-900 dark:text-gray-100">${projection.year}</td>
          <td class="px-4 py-2 text-sm text-gray-900 dark:text-gray-100">$${projection.fcf.toFixed(2)}</td>
          <td class="px-4 py-2 text-sm text-gray-900 dark:text-gray-100">${projection.pv_factor.toFixed(4)}</td>
          <td class="px-4 py-2 text-sm text-gray-900 dark:text-gray-100">$${projection.present_value.toFixed(2)}</td>
        `;
        tbody.appendChild(row);
      });
    }

    // Update charts when theme changes
    const observer = new MutationObserver(() => {
      if (cashFlowChart) {
        const isDark = document.documentElement.classList.contains('dark');
        const textColor = isDark ? '#e5e7eb' : '#374151';
        const gridColor = isDark ? '#374151' : '#e5e7eb';

        cashFlowChart.options.scales.y.ticks.color = textColor;
        cashFlowChart.options.scales.y.grid.color = gridColor;
        cashFlowChart.options.scales.x.ticks.color = textColor;
        cashFlowChart.options.scales.x.grid.color = gridColor;
        cashFlowChart.options.plugins.legend.labels.color = textColor;
        cashFlowChart.update();
      }

      if (sensitivityChart) {
        const isDark = document.documentElement.classList.contains('dark');
        const textColor = isDark ? '#e5e7eb' : '#374151';
        const gridColor = isDark ? '#374151' : '#e5e7eb';

        sensitivityChart.options.scales.y.ticks.color = textColor;
        sensitivityChart.options.scales.y.grid.color = gridColor;
        sensitivityChart.options.scales.x.ticks.color = textColor;
        sensitivityChart.options.scales.x.grid.color = gridColor;
        sensitivityChart.options.plugins.legend.labels.color = textColor;
        sensitivityChart.update();
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    });
  </script>
</Layout>
