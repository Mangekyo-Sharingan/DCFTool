---
import Layout from '../layouts/Layout.astro';
import { Navigation } from '../components/Navigation';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Badge } from '../components/ui/badge';
import { Separator } from '../components/ui/separator';
import { FinancialInputs } from '../components/FinancialInputs';
import { AnalysisCharts } from '../components/AnalysisCharts';
import NotificationBar from '../components/NotificationBar';
import "../styles/global.css";
---

<Layout title="DCF Valuation Tool" description="Professional DCF analysis and company valuation platform">
  <NotificationBar client:load />

  <Navigation title="DCF Valuation Tool" showBackButton={true} client:load />

  <div id="app" class="min-h-screen bg-gradient-to-br from-background to-muted/20">
    <!-- Hero Section -->
    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
          Discounted Cash Flow Analysis
        </h1>
        <p class="text-lg text-muted-foreground max-w-3xl mx-auto mb-8">
          Professional-grade DCF valuation with comprehensive sensitivity analysis and scenario modeling
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          <Badge variant="secondary">Real-time Data</Badge>
          <Badge variant="secondary">Multi-year Projections</Badge>
          <Badge variant="secondary">Sensitivity Analysis</Badge>
          <Badge variant="secondary">Interactive Charts</Badge>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto pb-12 px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Company Information & Inputs -->
        <div class="lg:col-span-1 space-y-6">
          <!-- Company Information -->
          <Card>
            <CardHeader>
              <CardTitle class="flex items-center space-x-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m11 0a2 2 0 01-2 2H7a2 2 0 01-2-2m2-4h2m0 0h2m-2 0h2m-6 0h-2v2m0-2h2m-4 0h2m2-2h2m0 0h2"></path>
                </svg>
                <span>Company Information</span>
              </CardTitle>
            </CardHeader>
            <CardContent class="space-y-4">
              <div class="space-y-2">
                <Label htmlFor="ticker">Stock Ticker</Label>
                <Input
                  id="ticker"
                  placeholder="e.g., AAPL"
                  className="w-full"
                />
                <Button
                  id="fetch-data-btn"
                  variant="default"
                  className="w-full bg-primary text-primary-foreground hover:bg-primary/90"
                >
                  Fetch Company Data
                </Button>
              </div>

              <div class="space-y-2">
                <Label htmlFor="industry">Industry</Label>
                <Input
                  id="industry"
                  placeholder="e.g., Technology"
                  className="w-full"
                />
              </div>

              <div class="space-y-2">
                <Label htmlFor="company-name">Company Name</Label>
                <Input
                  id="company-name"
                  placeholder="Will be populated automatically"
                  className="w-full"
                  disabled
                />
              </div>
            </CardContent>
          </Card>

          <!-- Financial Inputs -->
          <FinancialInputs client:load />

          <!-- Analysis Options -->
          <Card>
            <CardHeader>
              <CardTitle class="flex items-center space-x-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <span>Analysis Options</span>
              </CardTitle>
            </CardHeader>
            <CardContent class="space-y-4">
              <div class="space-y-2">
                <Label htmlFor="projection-years">Projection Years</Label>
                <select id="projection-years" class="w-full px-3 py-2 border border-input bg-background rounded-md">
                  <option value="5">5 Years</option>
                  <option value="10">10 Years</option>
                  <option value="15">15 Years</option>
                </select>
              </div>

              <Separator />

              <Button id="calculate-dcf" variant="default" className="w-full bg-primary text-primary-foreground hover:bg-primary/90" size="lg">
                Calculate DCF Valuation
              </Button>
            </CardContent>
          </Card>
        </div>

        <!-- Results Section -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Valuation Results -->
          <Card>
            <CardHeader>
              <CardTitle class="flex items-center space-x-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                </svg>
                <span>Valuation Results</span>
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div id="results-container" class="text-center py-12 text-muted-foreground">
                <svg class="w-16 h-16 mx-auto mb-4 text-muted-foreground/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <p class="text-lg font-medium mb-2">Ready for Analysis</p>
                <p>Enter company information and financial inputs to calculate DCF valuation</p>
              </div>
            </CardContent>
          </Card>

          <!-- Charts Section -->
          <AnalysisCharts client:load />

          <!-- Detailed Projections Table -->
          <Card>
            <CardHeader>
              <CardTitle class="flex items-center space-x-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2h2a2 2 0 002-2z"></path>
                </svg>
                <span>Detailed Projections</span>
              </CardTitle>
              <CardDescription>
                Year-by-year financial projections and free cash flow calculations
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div id="projections-table" class="overflow-x-auto">
                <div class="text-center py-8 text-muted-foreground">
                  <p>Detailed projections table will appear here after calculation</p>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </main>
  </div>

  <!-- Scripts for DCF functionality -->
  <script>
    // Enhanced notification system
    function showNotification(type: string, message: string) {
      // Create a custom event to trigger the notification
      window.dispatchEvent(new CustomEvent('showNotification', {
        detail: { type, message }
      }));
    }

    // DCF calculation logic
    document.addEventListener('DOMContentLoaded', function() {
      const fetchDataBtn = document.getElementById('fetch-data-btn');
      const calculateBtn = document.getElementById('calculate-dcf');

      if (fetchDataBtn) {
        fetchDataBtn.addEventListener('click', async function() {
          const tickerElement = document.getElementById('ticker') as HTMLInputElement;
          const ticker = tickerElement?.value?.trim().toUpperCase();

          if (!ticker) {
            showNotification('warning', 'Please enter a stock ticker symbol');
            return;
          }

          try {
            const button = this as HTMLButtonElement;
            button.disabled = true;
            button.textContent = 'Fetching...';

            showNotification('info', 'Fetching company data...');

            const response = await fetch(`/api/company-data/${ticker}`, {
              method: 'GET',
              headers: {
                'Content-Type': 'application/json',
              }
            });

            const data = await response.json();

            if (data.success) {
              // Populate form fields with fetched data
              const companyNameElement = document.getElementById('company-name') as HTMLInputElement;
              const industryElement = document.getElementById('industry') as HTMLInputElement;

              // Populate the correct financial input fields
              const enterpriseValueElement = document.getElementById('enterprise-value') as HTMLInputElement;
              const debtElement = document.getElementById('debt') as HTMLInputElement;
              const cashElement = document.getElementById('cash') as HTMLInputElement;
              const sharesOutstandingElement = document.getElementById('shares-outstanding') as HTMLInputElement;
              const lastFCFElement = document.getElementById('last-fcf') as HTMLInputElement;
              const growthRateElement = document.getElementById('growth-rate') as HTMLInputElement;

              // Set company name (use ticker if company name not available)
              if (companyNameElement) {
                companyNameElement.value = data.company_name || ticker;
              }

              // Set industry
              if (data.industry && industryElement) {
                industryElement.value = data.industry;
              }

              // Populate financial fields with actual data from backend
              if (data.enterprise_value && enterpriseValueElement) {
                enterpriseValueElement.value = data.enterprise_value.toFixed(1);
              }

              if (data.debt && debtElement) {
                debtElement.value = data.debt.toFixed(1);
              }

              if (data.cash && cashElement) {
                cashElement.value = data.cash.toFixed(1);
              }

              if (data.shares_outstanding && sharesOutstandingElement) {
                sharesOutstandingElement.value = data.shares_outstanding.toFixed(1);
              }

              if (data.last_fcf && lastFCFElement) {
                lastFCFElement.value = data.last_fcf.toFixed(1);
              }

              if (data.growth_rate && growthRateElement) {
                growthRateElement.value = (data.growth_rate * 100).toFixed(1);
              }

              // Trigger event for FinancialInputs component to update
              window.dispatchEvent(new CustomEvent('companyDataFetched', {
                detail: data
              }));

              showNotification('success', `Successfully fetched data for ${ticker}! FCF: $${data.last_fcf?.toFixed(1) || 'N/A'}M`);
            } else {
              showNotification('error', data.message || 'Failed to fetch company data');
            }
          } catch (error) {
            console.error('Error fetching data:', error);
            showNotification('error', 'Network error while fetching data');
          } finally {
            const button = this as HTMLButtonElement;
            button.disabled = false;
            button.textContent = 'Fetch Company Data';
          }
        });
      }

      if (calculateBtn) {
        calculateBtn.addEventListener('click', async function() {
          showNotification('info', 'Calculating DCF valuation...');

          try {
            // Collect all the input data from the form with correct parameter names
            const ticker = (document.getElementById('ticker') as HTMLInputElement)?.value?.trim().toUpperCase();
            const enterpriseValue = parseFloat((document.getElementById('enterprise-value') as HTMLInputElement)?.value || '0');
            const debt = parseFloat((document.getElementById('debt') as HTMLInputElement)?.value || '0');
            const cash = parseFloat((document.getElementById('cash') as HTMLInputElement)?.value || '0');
            const sharesOutstanding = parseFloat((document.getElementById('shares-outstanding') as HTMLInputElement)?.value || '0');
            const lastFCF = parseFloat((document.getElementById('last-fcf') as HTMLInputElement)?.value || '0');
            const growthRate = parseFloat((document.getElementById('growth-rate') as HTMLInputElement)?.value || '5');
            const wacc = parseFloat((document.getElementById('wacc') as HTMLInputElement)?.value || '10');
            const terminalGrowth = parseFloat((document.getElementById('terminal-growth') as HTMLInputElement)?.value || '2.5');
            const projectionYears = parseInt((document.getElementById('projection-years') as HTMLSelectElement)?.value || '5');

            // Validate inputs
            if (!ticker) {
              showNotification('warning', 'Please enter a stock ticker symbol first');
              return;
            }

            if (lastFCF <= 0) {
              showNotification('warning', 'Please fetch company data or enter Last FCF manually');
              return;
            }

            if (sharesOutstanding <= 0) {
              showNotification('warning', 'Please enter shares outstanding');
              return;
            }

            // Prepare DCF calculation data with exact parameter structure
            const dcfData = {
              ticker: ticker,
              enterprise_value: enterpriseValue,
              debt: debt,
              cash: cash,
              shares_outstanding: sharesOutstanding,
              last_fcf: lastFCF,
              growth_rate: growthRate,
              wacc: wacc,
              terminal_growth_rate: terminalGrowth,
              projection_years: projectionYears,
              industry: (document.getElementById('industry') as HTMLInputElement)?.value || 'N/A'
            };

            const response = await fetch('/api/calculate-dcf', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(dcfData)
            });

            const result = await response.json();

            if (result.success) {
              // Display results in the results container
              const resultsContainer = document.getElementById('results-container');
              if (resultsContainer) {
                resultsContainer.innerHTML = `
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
                    <div class="bg-primary/5 rounded-lg p-4">
                      <h3 class="font-semibold text-lg mb-2">Fair Value per Share</h3>
                      <p class="text-2xl font-bold text-primary">$${result.intrinsic_value?.toFixed(2) || 'N/A'}</p>
                      ${result.current_price ? `<p class="text-sm text-muted-foreground mt-1">Current: $${result.current_price.toFixed(2)}</p>` : ''}
                    </div>
                    <div class="bg-muted rounded-lg p-4">
                      <h3 class="font-semibold text-lg mb-2">Enterprise Value</h3>
                      <p class="text-xl font-semibold">$${result.input_parameters?.enterprise_value?.toFixed(1) || 'N/A'}M</p>
                    </div>
                    <div class="bg-muted rounded-lg p-4">
                      <h3 class="font-semibold text-lg mb-2">Total FCF (${projectionYears} years)</h3>
                      <p class="text-xl font-semibold">$${result.projections?.reduce((sum, proj) => sum + (proj.present_value || 0), 0).toFixed(1) || 'N/A'}M</p>
                    </div>
                  </div>
                  <div class="mt-6 text-center">
                    <p class="text-sm text-muted-foreground">
                      Based on ${projectionYears}-year projection with ${growthRate}% growth rate and ${wacc}% WACC
                    </p>
                  </div>
                `;
              }

              // Update projections table
              const projectionsTable = document.getElementById('projections-table');
              if (projectionsTable && result.projections) {
                let tableHTML = `
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="border-b">
                        <th class="text-left p-2">Year</th>
                        <th class="text-right p-2">FCF ($M)</th>
                        <th class="text-right p-2">PV Factor</th>
                        <th class="text-right p-2">Present Value ($M)</th>
                      </tr>
                    </thead>
                    <tbody>
                `;

                result.projections.forEach((proj: any) => {
                  tableHTML += `
                    <tr class="border-b hover:bg-muted/50">
                      <td class="p-2">${proj.year}</td>
                      <td class="text-right p-2">$${proj.fcf?.toFixed(1) || '0.0'}</td>
                      <td class="text-right p-2">${proj.pv_factor?.toFixed(4) || '0.0000'}</td>
                      <td class="text-right p-2">$${proj.present_value?.toFixed(1) || '0.0'}</td>
                    </tr>
                  `;
                });

                tableHTML += `
                    </tbody>
                    <tfoot>
                      <tr class="border-t-2 font-semibold">
                        <td class="p-2">Total</td>
                        <td class="text-right p-2">-</td>
                        <td class="text-right p-2">-</td>
                        <td class="text-right p-2">$${result.projections.reduce((sum: number, proj: any) => sum + (proj.present_value || 0), 0).toFixed(1)}</td>
                      </tr>
                    </tfoot>
                  </table>
                `;

                projectionsTable.innerHTML = tableHTML;
              }

              // Trigger chart updates with all available data
              window.dispatchEvent(new CustomEvent('dcfResultsCalculated', {
                detail: {
                  projections: result.projections,
                  sensitivity_analysis: result.sensitivity_analysis,
                  scenarios: result.scenarios || {}
                }
              }));

              showNotification('success', `DCF calculation completed! Fair value: $${result.intrinsic_value?.toFixed(2) || 'N/A'} per share`);
            } else {
              showNotification('error', result.error || 'DCF calculation failed');
            }
          } catch (error) {
            console.error('Error calculating DCF:', error);
            showNotification('error', 'Network error during DCF calculation');
          }
        });
      }
    });
  </script>
</Layout>
